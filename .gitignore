# Единый корневой репо workspace. Вложенных git-репозиториев больше нет — их .git
# удалены 2026-09-04, истории сохранены в backups/*.bundle и в архивах GitHub
# (Yagiar/nir-2-sem-full, Yagiar/SendVideoByUdpOnIphone, а также прежние
# MasterDiploma / MasterDiplomaVaultObsidian / SORT-DeepSORT-Tracker).

# Мусор ОС и временные lock-файлы MS Office
.DS_Store
~$*

# Логи
*.log

# Веса моделей (torch/TF/onnx-экспорты) — живут на диске, в git не храним
*.pt
*.onnx
*.engine
*.safetensors
*.pb

# Python-мусор и окружения
__pycache__/
*.py[cod]
.venv/
venv/

# Кадры sandbox для GT-разметки (тяжёлые, локальные)
research/sandbox_frames/

# Локальные материалы, НЕ публикуемые в remote (персональные документы, черновики, бандлы):
# Диплом-бака (зачётка, ВКР, антиплагиат), Vault (черновики диссертации), backups (git-бандлы),
# MasterDiploma/reports (отчёты НИР — антиплагиат-риски). Полная история — в локальном бандле
# backups/workspace-full-pre-public-2026-09-05.bundle.
/Диплом-бака/
/MasterDiplomaVaultObsidian/
/backups/
/MasterDiploma/reports/

# Производные аудио из MMAUD ROSBag (CC BY-NC-SA, пересоздаются mmaud_acoustic_eval.py) — не публикуем
research/mmaud_audio*.wav

# Локальное состояние планировщика сессий
.qoder/

# артефакты ultralytics при запуске eval из корня workspace (it-65)
runs/
