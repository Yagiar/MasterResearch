# Шаблон .env — скопировать в .env (в git не коммитится).
# Переопределяет значения из configs/pilot.yaml. Префикс UAVDET_ + путь через "__".

# Путь к YAML-профилю (если не задан — configs/pilot.yaml)
UAVDET_CONFIG=configs/pilot.yaml

# Kafka (для запуска сервисов вне Docker)
# UAVDET_KAFKA__BOOTSTRAP_SERVERS=localhost:9092

# Логирование
# UAVDET_LOGGING__LEVEL=DEBUG

# Уникальный source_id (если запускаешь несколько имитаторов)
# UAVDET_SOURCE__SOURCE_ID=cam-02

# Режим слияния
# UAVDET_FUSION__MODE=late
